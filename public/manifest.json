{
  "manifest_version": 3,
  "name": "Jira Bulk Time Logger",
  "version": "1.0.0",
  "description": "Bulk log time to Jira and view weekly time logs",
  "action": {
    "default_title": "Open Jira Time Logger"
  },
  "options_page": "src/app/app.html",
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://*.atlassian.net/browse/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["storage", "alarms", "notifications"],
  "host_permissions": ["https://*.atlassian.net/*"]
}